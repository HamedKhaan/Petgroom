<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:gravity="center_vertical" android:padding="14dp" android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card" android:layoutDirection="rtl">
    <TextView android:id="@+id/avatar" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center"
        android:text="🐾" android:textSize="23sp" android:background="@drawable/bg_soft"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/pg_text" android:textSize="16sp" android:textStyle="bold"/>
        <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/pg_muted" android:textSize="12sp"/>
    </LinearLayout>
    <TextView android:id="@+id/arrow" android:layout_width="28dp" android:layout_height="wrap_content" android:gravity="center" android:text="‹" android:textColor="@color/pg_muted" android:textSize="25sp"/>
</LinearLayout>