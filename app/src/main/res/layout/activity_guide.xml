<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/pg_bg" android:fillViewport="true" android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📖 راهنمای پت‌گروم" android:textColor="@color/pg_text" android:textSize="27sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="خیلی ساده بگیم: این برنامه قرار است پیگیری مشتری‌ها و پیامک‌ها را از دوشت بردارد." android:textColor="@color/pg_muted" android:textSize="14sp" android:layout_marginTop="5dp" android:layout_marginBottom="16dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_card">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="۱) مشتری اضافه کن 👤" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/pg_text"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="از «مشتریان» می‌توانی مشتری را دستی ثبت کنی یا از مخاطبین گوشی واردش کنی. اسم صاحب، شماره و اسم پت را وارد کن؛ همین کافی است." android:textSize="14sp" android:textColor="@color/pg_text" android:layout_marginTop="7dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="۲) نوبت بعدی را ثبت کن 📅" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/pg_text" android:layout_marginTop="18dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تاریخ نوبت بعدی را بنویس. وقتی تاریخ رد شود، مشتری در «موعدهای گذشته» دیده می‌شود تا یادت نرود پیگیری‌اش کنی." android:textSize="14sp" android:textColor="@color/pg_text" android:layout_marginTop="7dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="۳) پیامک بفرست 💬" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/pg_text" android:layout_marginTop="18dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="قالب پیام را انتخاب کن، اگر خواستی متنش را تغییر بده و ارسال را بزن. مشتری‌هایی که «پیامک ارسال نشود» برایشان فعال باشد، خودکار کنار گذاشته می‌شوند." android:textSize="14sp" android:textColor="@color/pg_text" android:layout_marginTop="7dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="۴) پیام‌ها را شخصی کن ✍️" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/pg_text" android:layout_marginTop="18dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="در تنظیمات می‌توانی پیام پایه و هر قالب دیگری را خودت بنویسی. {name} اسم صاحب و {pet} اسم پت را خودکار جایگزین می‌کند." android:textSize="14sp" android:textColor="@color/pg_text" android:layout_marginTop="7dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="۵) یک نکته مهم 🔒" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/pg_text" android:layout_marginTop="18dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="اطلاعات مشتری‌ها روی همین گوشی نگهداری می‌شود. قبل از ارسال گروهی، متن پیام را یک بار بخوان و مطمئن شو سیم‌کارت مناسب داخل گوشی است." android:textSize="14sp" android:textColor="@color/pg_text" android:layout_marginTop="7dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
