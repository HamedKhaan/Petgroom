<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:gravity="center_vertical" android:padding="12dp" android:layout_marginBottom="7dp"
    android:background="@drawable/bg_card" android:layoutDirection="rtl">
    <CheckBox android:id="@+id/box" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/avatar" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="👤" android:textSize="18sp" android:background="@drawable/bg_soft"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/pg_text" android:textSize="15sp" android:textStyle="bold"/>
        <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/pg_muted" android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>