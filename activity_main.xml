<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="20dp"
    android:layoutDirection="rtl">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="پت‌گروم سالن" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="8dp" android:paddingBottom="16dp"
            android:text="کاملاً آفلاین — بدون اینترنت" android:textSize="14sp" />
        <Button android:id="@+id/btnClients" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="مشتریان (دستی / ویرایش)" />
        <Button android:id="@+id/btnContacts" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="ورود از مخاطبین گوشی" />
        <Button android:id="@+id/btnOverdue" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="موعد گذشته" />
        <Button android:id="@+id/btnSend" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="ارسال پیامک از سیم‌کارت" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="20dp" android:textSize="13sp"
            android:text="داده فقط روی همین گوشی است. پیامک با آنتن موبایل می‌رود؛ اینترنت لازم نیست." />
    </LinearLayout>
</ScrollView>
